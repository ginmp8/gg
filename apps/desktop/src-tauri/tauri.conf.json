{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gita Desktop",
  "version": "0.2.0",
  "identifier": "dev.gita.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:4444",
    "frontendDist": "../../../apps/web/out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first Git analytics",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "api-dist/**/*"
    ]
  }
}
