{
  "name": "gg-analytics",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "npm --workspace @gg/db run generate",
    "db:migrate": "npm --workspace @gg/db run migrate",
    "db:studio": "npm --workspace @gg/db run studio",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:check": "node --test scripts/desktop/*.test.mjs",
    "cli": "node --import tsx scripts/gg-cli.ts",
    "screenshots": "node scripts/gg-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.29",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.12",
    "esbuild": "0.25.12",
    "@tauri-apps/cli": "2.12.4"
  },
  "overrides": {
    "postcss": "8.5.32",
    "zod": "4.6.7",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
